generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderType {
  LIMIT
  MARKET
}

enum TradingType {
  BUY
  SELL
  EDIT
  CANCEL
}

enum CancelReason {
  USER // 사용자 요청에 의한 취소
  SYSTEM // 시스템(휴장 정리 등)에 의한 강제 취소
}

enum CursorType {
  DB_APPLIED_OUTPUT_SEQ
  MQ_PUBLISHED_OUTPUT_SEQ
}

enum OrderStatus {
  RECEIVED // 접수됨 (DB 기록 완료, 큐 적재 전)
  OPEN // 큐 적재 성공 (엔진으로 전달된 활성 주문)
  FILLED // 완전 체결되어 종료
  CANCELED // 주문이 취소되어 닫힘
  REPLACED // 정정 주문으로 대체되어 닫힘
  REJECTED // 거부됨
  COMPLETED // 요청한 주문을 처리함 (EDIT, CANCLE만 해당)
}

enum OrderRejectReason {
  INVALID_ORDER // 잘못된 주문
  INSUFFICIENT_BALANCE // 예수금 부족
  INSUFFICIENT_STOCK // 보유 수량 부족
  STOCK_NOT_TRADABLE // 거래 불가능 한 종목일 경우 (거래정지/상장폐지 등등..)
  ORDER_NOT_ACTIVE // 원본 주문이 없거나 이미 처리된 주문일 경우
}

enum Role {
  ADMIN
  USER
}

enum StockStatus {
  PENDING // 상장 전 (엔진 처리 대기)
  LISTED // 상장
  SUSPENDED // 거래 정지
  DELISTED // 상장 폐지
}

enum AccountStatus {
  PENDING // 대기 (엔진 처리 대기)
  ACTIVE // 활성
}

enum TransferStatus {
  RECEIVED // 접수됨 (엔진 처리 대기)
  REJECTED // 거부됨
  COMPLETED // 송금 완료
}

enum TransferRejectReason {
  INSUFFICIENT_BALANCE // 발신 계좌 잔액 부족
  INVALID_RECIPIENT // 존재하지 않는 수신 계좌
  INVALID_SENDER // 존재하지 않는 발신 계좌
  SENDER_NOT_ACTIVE // 발신 계좌가 비활성 상태
  RECIPIENT_NOT_ACTIVE // 수신 계좌가 비활성 상태
  SELF_TRANSFER // 본인 계좌로 송금 시도
  INVALID_REQUEST
}

enum AdminRequestType {
  STOCK_SUSPEND // 거래 정지
  STOCK_RESUME // 거래 재개
  STOCK_DELIST // 상장 폐지
  ACCOUNT_DEPOSIT // 입금
  ACCOUNT_WITHDRAW // 출금
  STOCK_DEPOSIT // 주식 입고
  STOCK_WITHDRAW // 주식 출고
}

enum AdminRequestStatus {
  RECEIVED // 접수됨 (엔진 처리 대기)
  COMPLETED // 엔진 처리 완료
  REJECTED // 거부됨
}

enum AdminRequestRejectReason {
  TARGET_NOT_FOUND // 대상(주식/계좌/주문) 없음
  INVALID_STATE // 대상 상태가 명령과 불일치 (예: 이미 상장폐지)
  INSUFFICIENT_BALANCE // 출금시 잔고 부족
  INSUFFICIENT_STOCK // 주식 출고식 잔고 부족
  INVALID_REQUEST
}

enum CandleType {
  ONE_MINUTE      @map("1m")
  FIVE_MINUTES    @map("5m")
  FIFTEEN_MINUTES @map("15m")
  THIRTY_MINUTES  @map("30m")
  ONE_HOUR        @map("1h")
  ONE_DAY         @map("1d")
}

// NOTE: 테이블 필드 중에서 PublishedAt, CompletedAt은
// 큐에 Publish된 시각, 엔진이 요청을 처리한 시각을 의미합니다.

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(20)
  password  String   @db.VarChar(60)
  email     String   @unique @db.VarChar(50)
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")

  accounts      Account[]
  refreshTokens RefreshToken[]
  adminRequests AdminRequest[]

  @@map("users")
}

model RefreshToken {
  id          Int    @id @default(autoincrement())
  userId      Int    @map("user_id")
  hashedToken String @map("hashed_token")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

// 일반 계좌
model Account {
  id               Int           @id @default(autoincrement())
  userId           Int           @map("user_id")
  accountNumber    Int           @unique @map("account_number")
  balance          BigInt        @db.UnsignedBigInt
  availableBalance BigInt        @map("available_balance") @db.UnsignedBigInt
  status           AccountStatus @default(PENDING)
  publishedAt      DateTime?     @map("published_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id])
  userStocks UserStock[]
  orders     Order[]

  transfersSent     Transfer[] @relation("TransferSender")
  transfersReceived Transfer[] @relation("TransferRecipient")

  @@index([publishedAt])
  @@map("accounts")
}

// 계좌 간 송금
model Transfer {
  id                 BigInt                @id @default(autoincrement())
  senderAccountId    Int                   @map("sender_account_id")
  recipientAccountId Int                   @map("recipient_account_id")
  senderAlias        String?               @map("sender_alias") @db.VarChar(20) // 수신자에게 보이는 발신자 커스텀 이름
  amount             BigInt                @db.UnsignedBigInt
  status             TransferStatus        @default(RECEIVED)
  rejectReason       TransferRejectReason? @map("reject_reason")
  publishedAt        DateTime?             @map("published_at")
  completedAt        DateTime?             @map("completed_at")
  createdAt          DateTime              @default(now()) @map("created_at")

  senderAccount    Account @relation("TransferSender", fields: [senderAccountId], references: [id])
  recipientAccount Account @relation("TransferRecipient", fields: [recipientAccountId], references: [id])

  @@index([publishedAt])
  @@index([senderAccountId, createdAt])
  @@index([recipientAccountId, createdAt])
  @@map("transfers")
}

// 어드민 요청
model AdminRequest {
  id           BigInt                    @id @default(autoincrement())
  type         AdminRequestType
  payload      Json
  status       AdminRequestStatus        @default(RECEIVED)
  rejectReason AdminRequestRejectReason? @map("reject_reason")

  requestedBy Int       @map("requested_by")
  publishedAt DateTime? @map("published_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  requester User @relation(fields: [requestedBy], references: [id])

  @@index([publishedAt])
  @@index([type, status, createdAt])
  @@map("admin_requests")
}

// 주식 정보
model Stock {
  id           Int         @id @default(autoincrement())
  name         String      @unique @db.VarChar(30)
  price        BigInt      @db.UnsignedBigInt
  listingPrice BigInt      @map("listing_price") @db.UnsignedBigInt
  status       StockStatus @default(PENDING)
  publishedAt  DateTime?   @map("published_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime?   @updatedAt @map("updated_at")

  userStocks UserStock[]
  orders     Order[]
  trades     Trade[]
  candles    Candle[]

  @@index([publishedAt])
  @@map("stocks")
}

// 캔들 (차트 봉 데이터)
model Candle {
  stockId    Int        @map("stock_id")
  candleTime DateTime   @map("candle_time")
  type       CandleType
  open       BigInt     @db.UnsignedBigInt
  high       BigInt     @db.UnsignedBigInt
  low        BigInt     @db.UnsignedBigInt
  close      BigInt     @db.UnsignedBigInt
  volume     BigInt     @db.UnsignedBigInt

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@id([stockId, candleTime, type])
  @@index([stockId, type, candleTime])
  @@map("candles")
}

// 주식 계좌(보유 종목) 정보
model UserStock {
  accountId         Int    @map("account_id")
  stockId           Int    @map("stock_id")
  quantity          BigInt @db.UnsignedBigInt
  availableQuantity BigInt @map("available_quantity") @db.UnsignedBigInt
  average           BigInt @db.UnsignedBigInt
  totalBuyAmount    BigInt @map("total_buy_amount") @db.UnsignedBigInt

  account Account @relation(fields: [accountId], references: [id])
  stock   Stock   @relation(fields: [stockId], references: [id])

  @@id([accountId, stockId])
  @@map("user_stocks")
}

// 주문
model Order {
  id             BigInt             @id @default(autoincrement())
  targetId       BigInt?            @map("target_id") // 정정/취소 대상 원주문 (신규 주문이면 null)
  accountId      Int                @map("account_id")
  stockId        Int                @map("stock_id")
  price          BigInt             @db.UnsignedBigInt
  quantity       BigInt             @db.UnsignedBigInt
  filledQuantity BigInt             @map("filled_quantity") @db.UnsignedBigInt
  orderType      OrderType          @map("order_type")
  status         OrderStatus        @default(RECEIVED)
  rejectReason   OrderRejectReason? @map("reject_reason")
  tradingType    TradingType        @map("trading_type")
  cancelReason   CancelReason?      @map("cancel_reason")
  publishedAt    DateTime?          @map("published_at")
  fullyFilledAt  DateTime?          @map("fully_filled_at") // 전량 체결 시각 (null = 미체결/부분체결)
  createdAt      DateTime           @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])
  stock   Stock   @relation(fields: [stockId], references: [id])

  target     Order?  @relation("OrderTarget", fields: [targetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targetedBy Order[] @relation("OrderTarget")

  tradesAsMaker Trade[] @relation("TradeMaker")
  tradesAsTaker Trade[] @relation("TradeTaker")

  @@index([publishedAt])
  @@index([stockId, status, tradingType, price])
  @@index([accountId, status, createdAt])
  @@index([accountId, createdAt])
  @@map("orders")
}

// 체결 내역
model Trade {
  id           BigInt   @id @default(autoincrement())
  stockId      Int      @map("stock_id")
  price        BigInt   @db.UnsignedBigInt // 체결가
  quantity     BigInt   @db.UnsignedBigInt
  makerOrderId BigInt   @map("maker_order_id") // 기존에 존재한 주문
  takerOrderId BigInt   @map("taker_order_id") // 체결을 발생시킨 주문
  matchedAt    DateTime @default(now()) @map("matched_at")

  stock      Stock @relation(fields: [stockId], references: [id])
  makerOrder Order @relation("TradeMaker", fields: [makerOrderId], references: [id])
  takerOrder Order @relation("TradeTaker", fields: [takerOrderId], references: [id])

  @@index([stockId, matchedAt])
  @@map("trades")
}

// 엔진 상태 스냅샷
model Snapshot {
  id            BigInt   @id @default(autoincrement())
  state         Bytes    @map("state") @db.LongBlob // 직렬화된 엔진 전체 상태
  inputWalIndex BigInt   @map("input_wal_index") @db.UnsignedBigInt // 스냅샷에 반영된 Input WAL Index
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("snapshots")
}

// 커서 
// NOTE: 엔진에서 Output WAL을 기반으로 이벤트와 DB를 업데이트 하는 고루틴이 존재
// 이들이 어느 Output WAL까지 읽었는지 엔진 복구시 필요하기 때문에 이를 저장하는 테이블이 필요함
model Cursor {
  type  CursorType @id
  index BigInt

  @@map("cursors")
}
